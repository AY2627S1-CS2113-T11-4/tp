@startuml
' Running "filter 4 /time 45": finding available games for 4 players that take 45 minutes or less
hide footbox

participant ":GameVault" as GV
participant "<<class>>\nParser" as P
participant ":FilterCommand" as FC
participant ":GameList" as GL
participant ":Game" as G
participant ":Ui" as UI

activate GV
GV -> P : parse("filter 4 /time 45")
activate P
P -> P : splitByPrefixes(...)
note right of P
  count = "4"
  /time = "45"
  (no /diff or /notplayedin)
end note
create FC
P -> FC : new FilterCommand(4, 45, ...)
activate FC
FC --> P
deactivate FC
P --> GV
deactivate P

GV -> FC : execute(games, ui, storage)
activate FC
FC -> GL : filterAvailable(4, 45, null)
activate GL
loop each game in the list
  GL -> G : fitsPlayerCount(4)
  activate G
  G --> GL
  deactivate G
  opt fits 4 players
    GL -> G : fitsTime(45)
    activate G
    G --> GL
    deactivate G
    opt fits in 45 minutes
      GL -> G : isAvailable()
      activate G
      G --> GL
      deactivate G
    end
  end
end
GL --> FC : matches
deactivate GL

FC -> GL : countWithoutPlayTime(4, null)
activate GL
GL --> FC : untimedCount
deactivate GL

FC -> GL : describe lent games left out
activate GL
GL --> FC : note
deactivate GL

FC -> UI : showMessage(matches and notes)
activate UI
UI --> FC
deactivate UI
FC --> GV
deactivate FC
@enduml
